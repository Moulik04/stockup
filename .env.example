# Which data track to run the pipeline against: "a" (M5, public) or "b" (business, private)
REORDERPOINT_TRACK=a

# Track B (private) — path to the business data export. Never commit the real file.
# Expected schema documented in data/track_b/README.md
TRACK_B_DATA_PATH=

# Kaggle credentials for scripts/download_m5.py (or rely on ~/.kaggle/ credentials)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Decision layer cost parameters (USD) — Track A defaults are illustrative,
# not real business numbers. Track B values must come from the business owner.
# Fraction of unit cost charged per DAY that a unit sits on hand — the simulation accrues it every
# day (docs/decision.md "Cost simulation"), so this is an annual carrying cost divided by 365.
# Default: 0.000685 = 25%/yr, "a widely quoted average for the US industry" (Goetschalckx, Logistics
# Systems Design, ch. 5, Georgia Tech ISyE) — a cross-industry figure, not a retail measurement; see
# docs/decision.md "Holding cost rate". It was 0.02 (~730%/yr) until 2026-09-20; that value is why the
# original cost ranking favoured LightGBM. The LightGBM/SeasonalNaive ranking flips at ~132%/yr at
# the default 95% service target (~34%/yr at the cost-optimal target), so it does not hinge on
# which rate inside 15-30% is chosen — but it does depend on the penalty and the service target
# (reports/holding_breakeven_*.md, reports/penalty_sensitivity_*.md).
# Track B: replace with the business's own figure, divided by 365.
HOLDING_COST_RATE=0.000685
# Stockout economics. A lost sale costs GROSS_MARGIN x price and stock is valued at
# (1 - GROSS_MARGIN) x price. Default 0.275: Walmart Inc. Form 10-K, fiscal year ended 2026-01-31,
# Walmart U.S. segment (net sales $482,975M, gross profit $132,615M) — M5 is Walmart U.S. store
# data — and a lower bound on what a stockout costs (docs/decision.md). Consolidated Walmart is
# 0.242. Track B: the business's own gross margin.
# GROSS_MARGIN=0.275
# Legacy alternative (flat $ per lost unit, stock valued at price — how every number before
# 2026-09-20 was priced; unsourced). Setting it switches the model back to flat; set one or the
# other, not both.
# STOCKOUT_PENALTY_PER_UNIT=5.00
LEAD_TIME_DAYS=7
SERVICE_LEVEL_TARGET=0.95
# Order-up-to level: S = s + LOT_MULTIPLE x expected lead-time demand (0 = the original S = s).
# Default 2.0, from reports/order_up_to_*.md. Not an EOQ: Track A has no ordering cost, and the
# simulation prices none — with a real one the economic lot would be larger.
# LOT_MULTIPLE=2.0
